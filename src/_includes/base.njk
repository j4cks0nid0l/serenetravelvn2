<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{% if title %}{{ title }} · {% endif %}Serene Travel – Serene, not standard</title>
  <meta name="description" content="{{ description or site.defaultDescription }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}Serene Travel">
  <meta property="og:description" content="{{ description or site.defaultDescription }}">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip-link" href="#main">Bỏ qua điều hướng</a>

<header class="site-header" id="site-header">
  <div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label="Serene Travel - Trang chủ">
      <img src="/images/logo.jpg" alt="Logo Serene Travel" width="44" height="44">
      <span class="nav-logo-text">
        <span class="brand">Serene Travel</span>
        <span class="tagline">{{ site.tagline }}</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Mở menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Menu chính">
      <ul class="nav-links">
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/#about">Giới thiệu</a></li>

        {% for cat in menu.categories %}
        {% set items = collections.services | servicesIn(cat.slug) %}
        <li class="nav-dropdown">
          <a href="/{{ cat.slug }}/" class="nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false">
            {{ cat.name }} <span class="nav-arrow" aria-hidden="true">▾</span>
          </a>
          <ul class="nav-dropdown-menu">
            <li><a href="/{{ cat.slug }}/">Xem tất cả</a></li>
            {% for s in items %}
            <li><a href="{{ s.url }}">{{ s.data.title }}</a></li>
            {% endfor %}
          </ul>
        </li>
        {% endfor %}

        <li><a href="/cam-nang/">Cẩm nang du lịch</a></li>
        <li><a href="/#contact">Liên hệ</a></li>
      </ul>

      <div class="nav-mobile-extra">
        <a href="/#contact" class="btn btn-primary">Tư vấn ngay</a>
        <div class="nav-social">
          <a href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          <a href="{{ site.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.19 8.19 0 004.79 1.54V6.78a4.85 4.85 0 01-1.02-.09z"/></svg>
          </a>
        </div>
      </div>
    </nav>

    <div class="nav-right">
      <div class="nav-social">
        <a href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
        </a>
        <a href="{{ site.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.19 8.19 0 004.79 1.54V6.78a4.85 4.85 0 01-1.02-.09z"/></svg>
        </a>
      </div>
      <a href="/#contact" class="btn btn-primary nav-cta">Tư vấn ngay</a>
    </div>
  </div>
</header>

<main id="main">
  {% block content %}{% endblock %}
</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="brand-name">Serene Travel</div>
        <div class="slogan">{{ site.tagline }}</div>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <h4>Dịch vụ</h4>
          <ul>
            {% for cat in menu.categories %}
            <li><a href="/{{ cat.slug }}/">{{ cat.name }}</a></li>
            {% endfor %}
            <li><a href="/cam-nang/">Cẩm nang du lịch</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Công ty</h4>
          <ul>
            <li><a href="/#about">Giới thiệu</a></li>
            <li><a href="/#why">Tại sao chọn chúng tôi</a></li>
            <li><a href="/#contact">Liên hệ</a></li>
            <li><a href="/chinh-sach-bao-mat/">Chính sách bảo mật</a></li>
            <li><a href="/dieu-khoan-su-dung/">Điều khoản sử dụng</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Liên hệ</h4>
          <ul>
            <li><a href="{{ site.zaloUrl }}" target="_blank" rel="noopener">Zalo: {{ site.phone }}</a></li>
            <li>{{ site.address }}</li>
            <li>{{ site.hours }}</li>
            {% if site.gpkd %}<li>GPKD: {{ site.gpkd }}</li>{% endif %}
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div>© {{ meta.year }} Serene Travel · Nha Trang, Khánh Hòa</div>
      <div>Hotline: <a href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a></div>
    </div>
  </div>
</footer>

<div class="float-buttons">
  <a href="{{ site.zaloUrl }}" target="_blank" rel="noopener" class="float-btn float-btn-zalo" aria-label="Chat Zalo">
    <span class="float-btn-tooltip">Chat Zalo</span>
    <span class="float-btn-text">Zalo</span>
  </a>
  <a href="tel:{{ site.phoneRaw }}" class="float-btn float-btn-call" aria-label="Gọi điện">
    <span class="float-btn-tooltip">Gọi điện</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
  </a>
</div>

<script src="/js/main.js" defer></script>
</body>
</html>
